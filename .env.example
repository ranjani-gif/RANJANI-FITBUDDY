# Required: get a Gemini API key from Google's Gemini API / AI Studio.
GOOGLE_API_KEY=your_gemini_api_key_here

# Change these if the models available to your API key differ.
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_TIP_MODEL=gemini-2.5-flash

# Required to access the admin dashboard.
ADMIN_KEY=change-this-to-a-long-random-key

# Optional. Default stores fitbuddy.db in the project folder.
DATABASE_URL=sqlite:///./fitbuddy.db
